library(ggplot2)
library(dplyr)
library(hexSticker)
library(png)
library(scales)
# -----------------------------
# 1. FPZ segment positions
# -----------------------------
fpz_df <- tibble::tribble(
~fpz,    ~xmin, ~xmax, ~y,
"FPZ 1", 0.16,  0.31,  0.26,
"FPZ 2", 0.31,  0.46,  0.26,
"FPZ 3", 0.46,  0.61,  0.26,
"FPZ 4", 0.61,  0.76,  0.26,
"FPZ 5", 0.76,  0.91,  0.26
) %>%
mutate(xmid = (xmin + xmax) / 2)
fpz_cols <- c(
"FPZ 1" = "#1B9E77",
"FPZ 2" = "#2C7FB8",
"FPZ 3" = "#D95F02",
"FPZ 4" = "#7570B3",
"FPZ 5" = "#E6AB02"
)
# -----------------------------
# 2. Dendrogram structure
# -----------------------------
# trunk and branch hierarchy
dendro_segments <- tibble::tribble(
~x,   ~y,   ~xend, ~yend,
0.54, 0.88, 0.54, 0.73,   # trunk
0.54, 0.73, 0.35, 0.60,   # left split
0.54, 0.73, 0.73, 0.60,   # right split
0.35, 0.60, 0.24, 0.48,   # left child 1
0.35, 0.60, 0.43, 0.48,   # left child 2
0.73, 0.60, 0.62, 0.48,   # right child 1
0.73, 0.60, 0.81, 0.48,   # right child 2
0.62, 0.48, 0.69, 0.39,   # split to final right-middle
0.62, 0.48, 0.57, 0.39    # split to final center
)
# terminal connectors from dendrogram leaves to segment centers
leaf_connectors <- tibble::tribble(
~fpz,    ~x,   ~y,   ~xend, ~yend,
"FPZ 1", 0.24, 0.48, 0.235, 0.31,
"FPZ 2", 0.43, 0.48, 0.385, 0.31,
"FPZ 3", 0.57, 0.39, 0.535, 0.31,
"FPZ 4", 0.69, 0.39, 0.685, 0.31,
"FPZ 5", 0.81, 0.48, 0.835, 0.31
)
# -----------------------------
# 3. Optional subtle river baseline
# -----------------------------
river_base <- tibble::tribble(
~x,   ~y,   ~xend, ~yend,
0.14, 0.26, 0.93, 0.26
)
# -----------------------------
# 4. Build icon plot
# -----------------------------
icon_plot <- ggplot() +
# subtle river baseline behind the colored segments
geom_segment(
data = river_base,
aes(x = x, y = y, xend = xend, yend = yend),
linewidth = 2.0,
color = alpha("white", 0.10),
lineend = "round"
) +
# colored FPZ river reaches
geom_segment(
data = fpz_df,
aes(x = xmin, y = y, xend = xmax, yend = y, color = fpz),
linewidth = 2.0,
lineend = "round"
) +
# white halo below connectors for contrast
geom_segment(
data = leaf_connectors,
aes(x = x, y = y, xend = xend, yend = yend),
linewidth = 2.5,
color = alpha("white", 0.12),
lineend = "round"
) +
# colored terminal connectors
geom_segment(
data = leaf_connectors,
aes(x = x, y = y, xend = xend, yend = yend, color = fpz),
linewidth = 2.0,
lineend = "round"
) +
# main dendrogram in white
geom_segment(
data = dendro_segments,
aes(x = x, y = y, xend = xend, yend = yend),
linewidth = 1.2,
color = "white",
lineend = "round"
) +
# little white node at trunk top
geom_point(
aes(x = 0.54, y = 0.88),
color = "white",
size = 2.2
) +
scale_color_manual(values = fpz_cols) +
coord_equal(xlim = c(0, 1), ylim = c(0, 1), expand = FALSE) +
theme_void() +
theme(
legend.position = "none",
plot.background = element_rect(fill = "transparent", color = NA),
panel.background = element_rect(fill = "transparent", color = NA)
)
# preview
print(icon_plot)
# -----------------------------
# 5. Save transparent icon
# -----------------------------
ggsave(
filename = "ShinyFPZ_icon_horizontal.png",
plot = icon_plot,
width = 5,
height = 5,
dpi = 600,
bg = "transparent"
)
# -----------------------------
# 6. Wrap in hex sticker
# -----------------------------
sticker(
subplot = icon_plot,
package = "ShinyFPZ",
p_size = 20,
p_color = "white",
p_y = 1.5,
s_x = 1,
s_y = 0.8,
s_width = 3,
s_height = 1,
h_fill = "#062047",
h_color = "white",
filename = "ShinyFPZ_hex_horizontal.png"
)
sticker(
subplot = icon_plot,
package = "ShinyFPZ",
p_size = 20,
p_color = "white",
p_y = 1.5,
s_x = 1,
s_y = 0.8,
s_width = 3,
s_height = 1,
h_fill = "#062047",
h_color = "white",
filename = "ShinyFPZ_hex_horizontal.png",
spotlight=T
)
sticker(
subplot = icon_plot,
package = "ShinyFPZ",
p_size = 20,
p_color = "white",
p_y = 1.5,
s_x = 1,
s_y = 0.8,
