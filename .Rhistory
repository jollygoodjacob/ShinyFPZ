# Load required libraries
library(sf)          # For working with spatial data
library(dplyr)       # For data manipulation
library(cluster)     # For hierarchical FPZing
library(ggplot2)     # For plotting
library(ggfortify)   # For PCA plotting
library(FactoMineR)  # For PCA
library(factoextra)  # For enhanced PCA visualization
# Path to the shapefile
shapefile_path <- "C:/Users/jacob/Desktop/Russian_2026/RR_extracts.shp"
#shapefile_path <- "C:/Users/jacob/Desktop/RR_outputs/OpenRES/output/FPZs.shp"
#shapefile_path <- "C:/Users/jacob/Desktop/RR_outputs/Berg/08_Extract/center_points.shp"
#shapefile_path <- "C:/Users/jacob/Desktop/RR_outputs/Eerste/08_Extract/extract_2026/Eerste_extract.shp"
# Load the shapefile
center_points <- st_read(shapefile_path)
# Check the data
print(head(center_points))
print(summary(center_points))
# Ensure t_ID is an integer
center_points$t_ID <- as.integer(center_points$t_ID)
# Select relevant columns for FPZing and PCA
variables <- center_points %>%
select(ELE, PRE, GEO, VW, VFW, RAT, RVS,LVS, DVS, SIN) %>%
mutate(GEO = as.factor(GEO)) %>%
# mutate(CB = ifelse(is.na(CBW),0,1))%>%
st_drop_geometry() %>%  # Drop geometry for FPZing and PCA
mutate(across(-GEO, ~ (.- min(., na.rm = TRUE)) / (max(., na.rm = TRUE) - min(., na.rm = TRUE))))
# Encode categorical variables as numeric
variables$GEO <- as.factor(variables$GEO)
# Remove rows with missing data
#variables <- variables %>% na.omit() %>% filter(PRE != -9999)
# Perform hierarchical FPZing
diss<- daisy(variables, metric = "gower")  # Dissimilarity matrix
hc <- hclust(diss, method = "ward.D2")         # Hierarchical FPZing
# Silhouette Method for choosing FPZs
ks <- 2:20
sil_avg <- sapply(ks, function(k){
cl <- cutree(hc, k=k)
mean(silhouette(cl, diss)[,3])
})
k_best <- ks[which.max(sil_avg)]
FPZs <- cutree(hc, k=k_best)
variables$FPZ <- factor(FPZs)
sil <- silhouette(FPZs, diss)
plot(sil, border = NA)
sil <- silhouette(FPZs, diss)
#plot(is.na(variables$CBW), sil[,3], xlab="CBW is NA", ylab="Silhouette")
# Cut the dendrogram at 80% dissimilarity
cutoff <- 0.2 * max(hc$height)
FPZs <- cutree(hc, h = cutoff)
# Add FPZ labels to the variables
variables$FPZ <- as.factor(FPZs)
# Encode categorical variables as numeric
variables$GEO <- as.numeric(variables$GEO)
# Perform PCA
pca_result <- PCA(variables %>% select(-FPZ), scale.unit = TRUE, graph = FALSE)
# Extract the percentage of variance explained for each PC
percent_variance <- pca_result$eig[, 2]  # Extract the percent variance explained
pc1_var <- round(percent_variance[1], 1)  # Variance explained by PC1
pc2_var <- round(percent_variance[2], 1)  # Variance explained by PC2
pc3_var <- round(percent_variance[3], 1)  # Variance explained by PC2
# Individual coordinates (from FactoMineR PCA)
pca_coords <- as.data.frame(pca_result$ind$coord)
pca_coords$FPZ <- as.factor(variables$FPZ)
# Variable loadings
var_coords <- as.data.frame(pca_result$var$coord)
var_coords$varname <- rownames(var_coords)
# Scale arrows (match fviz_pca_biplot behavior)
arrow_scale <- min(
(max(pca_coords$Dim.1) - min(pca_coords$Dim.1)) / (max(var_coords$Dim.1) - min(var_coords$Dim.1)),
(max(pca_coords$Dim.2) - min(pca_coords$Dim.2)) / (max(var_coords$Dim.2) - min(var_coords$Dim.2))
) * 0.8  # 0.8 is a tuning factor (like fviz does)
var_coords_scaled <- var_coords
var_coords_scaled$Dim.1 <- var_coords$Dim.1 * arrow_scale
var_coords_scaled$Dim.2 <- var_coords$Dim.2 * arrow_scale
# Plot
ggplot(pca_coords, aes(x = Dim.1, y = Dim.2, color = FPZ)) +
geom_point(size = 2.5, shape = 19) +
geom_segment(data = var_coords_scaled,
aes(x = 0, y = 0, xend = Dim.1, yend = Dim.2),
color = "black", arrow = arrow(length = unit(0.2, "cm"))) +
geom_text(data = var_coords_scaled,
aes(x = Dim.1, y = Dim.2, label = varname),
color = "black", vjust = -0.8, hjust = 0.5, size = 3.5) +
scale_color_brewer(palette = "Set1") +
labs(
title = "PCA - FPZ clustering on hydrogeomorphic features",
x = paste0("PC1 (", pc1_var, "% variance)"),
y = paste0("PC2 (", pc2_var, "% variance)"),
color = "FPZ"
) +
theme_bw()+
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
axis.title = element_text(face = "bold"),
legend.title = element_text(face = "bold")
)
# Save the updated shapefile with FPZ labels
#center_points$FPZ <- NA
#center_points$FPZ <- variables$FPZ
#output_path <- "C:/Users/jacob/Desktop/Russian_2026/RR_FPZs_5km_2class.shp"
#output_path <- "C:/Users/jacob/Desktop/RR_outputs/Berg/08_Extract/center_points_with_FPZs.shp"
#st_write(center_points, output_path, append = FALSE)
